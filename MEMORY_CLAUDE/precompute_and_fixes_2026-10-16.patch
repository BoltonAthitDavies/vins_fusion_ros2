+/// Looks for a precomputed detection file beside the bag.
+///
+/// WHY THIS EXISTS. The detector is a separate ROS node that lives in
+/// orbslam3_ros2. Its launch file spawns one automatically; this node has no
+/// launch file, so for VINS the detector became something a human had to
+/// remember to start in another terminal. On 2026-09-16 it was forgotten for
+/// four Experiment 3 runs and again three times on 2026-10-15: the node
+/// subscribed, nothing ever published, and every frame recorded matched=0 --
+/// runs that look complete and filtered nothing. Asking the operator to also
+/// know about `dets_csv` was a second thing to remember, not a fix.
+///
+/// So: with filter:=true and no explicit dets_csv, look next to the dataset.
+/// One candidate is used. Several is ambiguous -- they are different detector
+/// weights and silently picking one would put the wrong provenance in the
+/// manifest -- so that is an error naming them, not a guess.
+static std::string autoDetsCsv(
+  const std::string & dataset_path, std::string & note)
+{
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  if (dataset_path.empty() || !fs::is_directory(dataset_path, ec)) {
+    note = "dataset_path is not a directory";
+    return {};
+  }
+  std::vector<std::string> found;
+  for (const auto & e : fs::directory_iterator(dataset_path, ec)) {
+    const auto name = e.path().filename().string();
+    if (name.rfind("dets", 0) == 0 && e.path().extension() == ".csv") {
+      found.push_back(e.path().string());
+    }
+  }
+  std::sort(found.begin(), found.end());
+  if (found.empty()) {
+    note = "no dets*.csv beside the bag; run script/yolo_precompute.py";
+    return {};
+  }
+  if (found.size() > 1) {
+    // Ambiguous only in principle: the chosen path is written to
+    // run_metadata.csv and the file's own `#` header names the weight and
+    // thresholds, so provenance survives the choice. Refusing to choose would
+    // just push the operator back to the failure this function exists to
+    // prevent. Prefer an unsuffixed dets.csv, then the project's primary
+    // weight, then alphabetical -- and say out loud what was picked.
+    auto prefer = [&found](const std::string & want) {
+      for (const auto & f : found) {
+        if (std::filesystem::path(f).filename() == want) return f;
+      }
+      return std::string{};
+    };
+    std::string pick = prefer("dets.csv");
+    if (pick.empty()) pick = prefer("dets_best.csv");
+    if (pick.empty()) pick = found.front();
+    note = "chose " + fs::path(pick).filename().string() + " of";
+    for (const auto & f : found) {
+      note += " " + fs::path(f).filename().string();
+    }
+    note += " -- pass dets_csv to override";
+    return pick;
+  }
+  note = "auto-discovered beside the bag";
+  return found.front();
+}
